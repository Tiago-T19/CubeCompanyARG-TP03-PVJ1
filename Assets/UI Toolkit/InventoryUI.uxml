                <ui:Label text="2" name="Slots-Quantity" style="position: absolute; top: auto; left: 7px; bottom: 4px; right: auto; font-size: 20px; -unity-text-outline-color: rgb(0, 0, 0); color: rgb(84, 98, 229); height: 26px; width: 10px;"/>
