                <ui:Label text="3" name="Slots-Quantity" style="position: absolute; top: auto; left: 6px; bottom: 3px; right: auto; font-size: 20px; -unity-text-outline-color: rgb(0, 0, 0); color: rgb(84, 119, 228); height: 26px; width: 10px;"/>
